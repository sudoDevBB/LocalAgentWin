{
  "manifest_version": 3,
  "name": "Soundroom Chrome Player",
  "version": "1.0.0",
  "description": "Lets Soundroom control YouTube playback in this signed-in Chrome profile.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765"
  }
}
